# ذاكرة pip المؤقتة — كانت مُودَعة (276 ملفاً ≈ 49MB) وتضخّم كل استنساخ
.cache/

# بيانات حقيقية — يُمنع رفعها
data/
*.csv

# AAdocs: النصوصُ الوزاريّةُ الحرفيّةُ لا تُرفع — المستودعُ عامّ، ونسخُها
# الاحتياطيّ مع نسخ الإنتاج المشفَّرة. ويُستثنى توثيقُ المشروع ومشتقّاتُ
# مصدر الحقيقة (تحليلُنا نحن: مصفوفةُ الصلاحيّات وتقريرُ الامتثال وخطّةُ
# الإصلاح) لأنّ الكودَ يُقارَن بها ويُخطَّط عليها.
AAdocs/*
!AAdocs/claude/
!AAdocs/ministry_data/
AAdocs/ministry_data/*
!AAdocs/ministry_data/2026_2027/
AAdocs/ministry_data/2026_2027/*
!AAdocs/ministry_data/2026_2027/index.md
!AAdocs/ministry_data/2026_2027/rbac_permissions_matrix.md
!AAdocs/ministry_data/2026_2027/rbac_roles.json
!AAdocs/ministry_data/2026_2027/compliance_audit_report.md
!AAdocs/ministry_data/2026_2027/remediation_plan.md
nginx/ssl/
node_modules/
ZZZZ.zip

# Claude Code worktrees
.claude/worktrees/

# Backup files
*.dump
*.bak
*.backup

# Temp/scratch scripts
_*.py
_*.txt
# Never ignore Python package markers (the _*.py rule above catches __init__.py)
!**/__init__.py

# Azkia config
.Azkia/

# Secrets scan results
.secrets-results.json

# Local archive — مجلد محلي للملفات القديمة/المبعثرة (لا يُرفع)
_archive/

# ── خطوطٌ مملوكة لا تُنشر ────────────────────────────────────────────
# «Traditional Arabic» ملكيّةُ Monotype، ومستودع هذا المشروع عامّ.
# فتُثبَّت على الخادم عبر `install_pdf_font` الذي يحفظها في القاعدة،
# ولا تدخل الشيفرة المنشورة.
static/fonts/trado.ttf
static/fonts/tradbdo.ttf
static/fonts/TRADO.TTF
static/fonts/TRADBDO.TTF

# بيئةُ pip داخل الحاوية: `docker compose exec web pip install` يكتب في
# /app/.local وهو مُجلَّدٌ مشتركٌ مع الشجرة — أدواتُ التطوير لا تُودَع.
.local/

# لقطاتُ الجدول قبل التوليد — بياناتُ تشغيلٍ لا كود.
backups/

# سكربتاتُ تحليلٍ مؤقّتةٌ في الجذر: تُكتب لسؤالٍ في جلسةٍ ثمّ تُنسى
# (قياسُ الفراغات، فحصُ التلاصق، نطاقاتُ التوقيت…). لا تُودَع كي لا يظنّها
# قارئُ المستودع أدواتٍ معتمَدة.
/adj.py
/adj2.py
/gaps.py
/tb.py
/scratch_*.py
