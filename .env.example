# ══════════════════════════════════════════════
#  مدرسة الشحانية — إعدادات البيئة
#  انسخ هذا الملف إلى .env وعدّل القيم
# ══════════════════════════════════════════════

# ── Core Django ───────────────────────────────
SECRET_KEY=your-secret-key-here-min-50-chars-replace-this
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ── Database ──────────────────────────────────
DB_NAME=shschool_db
DB_USER=shschool_user
DB_PASSWORD=change-me-to-a-strong-password
DB_HOST=localhost
DB_PORT=5432
# للـ Docker: DB_HOST=db

# ── Media & Static ────────────────────────────
MEDIA_ROOT=media
STATIC_ROOT=staticfiles

# ── Email (console للتطوير، smtp للإنتاج) ────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your@email.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@schoolos.qa

# ── Redis ─────────────────────────────────────
REDIS_PASSWORD=change-me-to-a-strong-redis-password
# REDIS_URL=redis://localhost:6379/0
# REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# ── AWS S3 Backup (اختياري) ───────────────────
# AWS_BACKUP_BUCKET=
# AWS_S3_REGION_NAME=me-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── تشفير البيانات الصحية (PDPPL) ─────────────
# توليد مفتاح:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# FERNET_KEY=your-fernet-key-here

# ── VAPID Push Notifications ──────────────────
# شغّل: python manage.py generate_vapid_keys لتوليد مفاتيح جديدة
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY_B64=
VAPID_CLAIMS_EMAIL=your-email@education.qa

# ── DPO — مسؤول حماية البيانات (PDPPL م.17) ──
DPO_NAME=اسم مسؤول حماية البيانات
DPO_EMAIL=dpo@education.qa
DPO_PHONE=00000000

# CDN — اختياري: نطاق CDN للملفات الثابتة (Cloudflare/CloudFront)
# CDN_DOMAIN=cdn.schoolos.qa
